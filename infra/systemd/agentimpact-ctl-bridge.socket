[Unit]
Description=hermesctl bridge Unix socket
Before=agentimpact-ctl-bridge.service

[Socket]
ListenStream=/run/agentimpact/hermesctl.sock
SocketUser=agentimpact-ctl
SocketGroup=agentimpact-ctl
SocketMode=0660
DirectoryMode=0750
Accept=no
Service=agentimpact-ctl-bridge.service

[Install]
WantedBy=sockets.target
