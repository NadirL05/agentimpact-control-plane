[Unit]
Description=AgentImpact hermesctl bridge
Requires=agentimpact-ctl-bridge.socket
After=agentimpact-ctl-bridge.socket network-online.target
ConditionPathExists=/etc/agentimpact/tokens/bridge.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=agentimpact-ctl
Group=agentimpact-ctl
UMask=0077
EnvironmentFile=/etc/agentimpact/tokens/bridge.env
WorkingDirectory=/opt/agentimpact/ctl-bridge
ExecStart=/usr/bin/python3 /opt/agentimpact/ctl-bridge/bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentimpact-ctl-bridge
