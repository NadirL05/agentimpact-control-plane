[Unit]
Description=AgentImpact Slack Router (Socket Mode)
# PG tourne dans Docker Compose — pas d'unité PostgreSQL hôte.
# docker.service actif ≠ Postgres ready : gate réel via ExecStartPre.
After=network-online.target docker.service agentimpact-grok-worker.socket
Wants=network-online.target docker.service
Requires=agentimpact-grok-worker.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=agentimpact-slack-router
Group=agentimpact-slack-router
SupplementaryGroups=agentimpact-grok-client
WorkingDirectory=/opt/agentimpact/app

# Secrets via LoadCredential — jamais dans EnvironmentFile
LoadCredential=slack-bot-token:/etc/agentimpact/credentials/slack-router-bot-token
LoadCredential=slack-app-token:/etc/agentimpact/credentials/slack-router-app-token
LoadCredential=slack-router-db-password:/etc/agentimpact/credentials/slack-router-db-password
LoadCredential=slack-router-bridge-token:/etc/agentimpact/credentials/gateway-inbox-bridge-token

Environment=SLACK_BOT_TOKEN_FILE=%d/slack-bot-token
Environment=SLACK_APP_TOKEN_FILE=%d/slack-app-token
Environment=PGPASSWORD_FILE=%d/slack-router-db-password
Environment=SLACK_ROUTER_BRIDGE_TOKEN_FILE=%d/slack-router-bridge-token
Environment=GROK_WORKER_SOCKET=/run/agentimpact-grok-worker/grok.sock
Environment=NODE_ENV=production
EnvironmentFile=-/etc/agentimpact/slack-router.env

# + = root : docker compose exec pg_isready (sans secret)
ExecStartPre=+/opt/agentimpact/scripts/wait-postgres-ready.sh
ExecStart=/usr/bin/node /opt/agentimpact/app/dist/slack-router/daemon.js
RuntimeDirectory=agentimpact-slack-router
RuntimeDirectoryMode=0750

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentimpact-slack-router
ReadOnlyPaths=/etc/agentimpact/flags /run/agentimpact-grok-worker

[Install]
WantedBy=multi-user.target
