[Unit]
Description=AgentImpact Gateway Inbox Consumer (Ana)
# docker.service actif ≠ API ready : gate HTTP /health via ExecStartPre.
After=network-online.target docker.service
Wants=network-online.target docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/agentimpact

LoadCredential=gateway-bridge-token:/etc/agentimpact/credentials/gateway-inbox-bridge-token

Environment=GATEWAY_INBOX_TARGET=ana
Environment=HERMES_PROFILE=agentimpact-growth
Environment=CONTROL_PLANE_URL=http://127.0.0.1:3000
Environment=SLACK_ROUTER_BRIDGE_TOKEN_FILE=%d/gateway-bridge-token
EnvironmentFile=-/etc/agentimpact/gateway-inbox.env

ExecStartPre=/opt/agentimpact/scripts/wait-control-plane-ready.sh
ExecStart=/opt/agentimpact/scripts/gateway-inbox-consumer.py --loop

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=660
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/agentimpact/profiles /opt/agentimpact/scripts /home/hermes/.hermes

[Install]
WantedBy=multi-user.target
