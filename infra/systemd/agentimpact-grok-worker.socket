[Unit]
Description=AgentImpact Grok Worker Unix Socket
Before=agentimpact-grok-worker.service

[Socket]
ListenStream=/run/agentimpact-grok-worker/grok.sock
SocketMode=0660
SocketUser=cursor-grok-worker
SocketGroup=agentimpact-grok-client
DirectoryMode=0750
Service=agentimpact-grok-worker.service

[Install]
WantedBy=sockets.target
