# AgentImpact Slack Router — variables non secrètes uniquement.
# Secrets : systemd LoadCredential (voir agentimpact-slack-router.service).
#   - slack-router-bot-token, slack-app-token
#   - slack-router-db-password (PGPASSWORD)
#   - gateway-inbox-bridge-token (route Codex)
# CURSOR_API_KEY : uniquement agentimpact-grok-worker (LoadCredential séparé).

# Obligatoire — Slack user_id de Nadir (pas le display name).
SLACK_NADIR_USER_ID=UXXXXXXXX

# Obligatoire en production — apps Slack natives à ne pas intercepter (CSV user_id).
# Récupérer les IDs via l’API Slack ou le panneau admin (jamais le display name).
# Exemple : Cursor, Codex, Devin, Hermès, Ana — un ID par app, séparés par des virgules.
# SLACK_NATIVE_AGENT_USER_IDS=UAAAAAAAA,UBBBBBBBB,UCCCCCCCC

# PostgreSQL (même instance que control-plane — mot de passe via LoadCredential)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=agentimpact
PGUSER=agentimpact_app

# Control-plane local
CONTROL_PLANE_URL=http://127.0.0.1:3000

# Socket worker Grok (aucune clé Cursor ici)
GROK_WORKER_SOCKET=/run/agentimpact-grok-worker/grok.sock

# Health / metrics (localhost uniquement)
SLACK_ROUTER_HEALTH_PORT=9120

# Rate limits Grok
GROK_RATE_USER_MAX=6
GROK_RATE_USER_WINDOW_MS=60000
GROK_RATE_CHANNEL_MAX=20
GROK_RATE_CHANNEL_WINDOW_MS=60000

GROK_KILL_SWITCH_PATH=/etc/agentimpact/flags/grokbot.disabled
