# Profil AgentImpact : agentimpact-growth
#
# Les secrets partages (OPENROUTER_API_KEY, SLACK_BOT_TOKEN...) ne sont PAS
# dupliques ici : run-with-profile.sh charge d'abord /home/hermes/.hermes/.env,
# puis ce fichier qui ne porte que les surcharges propres au profil.

PROFILE_NAME=agentimpact-growth
PROFILE_ROLE=growth
HERMES_PROFILE=agentimpact-growth

# Surcharges optionnelles (decommenter au besoin)
#SLACK_CHANNEL_ID=C0123456789
#HERMES_MODEL_PREMIUM=anthropic/claude-sonnet-4-6
#HERMES_MODEL_ECONO=google/gemini-2.5-flash-lite

# Brevo MCP (Growth uniquement) : secret dans /etc/agentimpact/hermes-growth.env
# (systemd hermes-gateway-growth). Ne pas dupliquer ici.
