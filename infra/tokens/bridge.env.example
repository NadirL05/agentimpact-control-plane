# Copier vers /etc/agentimpact/tokens/bridge.env (0400 agentimpact-ctl:agentimpact-ctl)
# Le playbook hermesctl-v1 impose ce propriétaire/mode après création du compte agentimpact-ctl.
# Pré-déploiement : root:root 0600 accepté (preflight) — jamais laisser root:agentimpact-ctl 0600 en prod.
# Ne jamais committer de valeur réelle.
CTL_BRIDGE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
AGENTIMPACT_API_BASE=http://127.0.0.1:3000
CONTROL_PLANE_URL=http://127.0.0.1:3000
ALLOWED_PEER_UIDS=1001
BRIDGE_VERSION=1.0.0
