# Copier vers /etc/agentimpact/tokens/bridge.env (0600 root:agentimpact-ctl)
# Ne jamais committer de valeur réelle.
CTL_BRIDGE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
AGENTIMPACT_API_BASE=http://127.0.0.1:3000
CONTROL_PLANE_URL=http://127.0.0.1:3000
ALLOWED_PEER_UIDS=1001
BRIDGE_VERSION=1.0.0
