{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "index.ts",
    "env.d.ts",
    "api/**/*.ts",
    "core/**/*.ts",
    "middleware/**/*.ts",
    "cli/**/*.ts",
    "slack-router/**/*.ts",
    "grok-worker/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.ts"
  ]
}
